# Puerto del servidor HTTP
PORT=3000

# Interfaz donde escucha. En un VPS detrás de Nginx/Caddy usar 127.0.0.1
# para que la app NO quede expuesta directamente a internet.
HOST=0.0.0.0

# Si está detrás de un proxy en la misma máquina: loopback.
# Si la app se expone directo (sin proxy): false.
TRUST_PROXY=false

# Tiempo máximo por request HTTP (ms)
REQUEST_TIMEOUT_MS=60000

# Clave que deben enviar los clientes en el header x-api-key
API_KEY=cambiar-por-una-clave-larga

# --- Rate limiting (por IP, en memoria) ---
RATE_LIMIT_ENABLED=true
# Límite general: 120 requests por minuto y por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Límite para /send y /send/grupo-noti: 30 mensajes por minuto por IP
RATE_LIMIT_SEND_WINDOW_MS=60000
RATE_LIMIT_SEND_MAX=30
# Límite para /restart: 5 por minuto por IP
RATE_LIMIT_RESTART_MAX=5

# --- Opcionales: proveedores de IA ---
OPENROUTER_API_KEY=
DEEP=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# --- Opcionales: avisos cuando WhatsApp falla ---

# Número o chat de WhatsApp que recibe los avisos (ej: 595981123456).
# Si WhatsApp está caído, el aviso se encola y se envía al reconectar.
ADMIN_NOTIFY_NUMBER=

# Webhook genérico (recibe un POST JSON con { service, host, level, key, text, timestamp })
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# Telegram (crear bot con @BotFather y obtener el chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Archivo de log (se crea el directorio si no existe). Vacío = solo consola.
LOG_FILE=./logs/wa-micredito.log
LOG_LEVEL=info

# --- Opcionales: tiempos de vigilancia y reconexión ---
WATCHDOG_INTERVAL_MS=30000
RECONNECT_MIN_DELAY_MS=5000
RECONNECT_MAX_DELAY_MS=60000
MAX_RECONNECT_ATTEMPTS=20
INIT_TIMEOUT_MS=120000
QR_MAX_AGE_MS=600000
ALERT_THROTTLE_MS=60000
SEND_WAIT_MS=10000
GROUP_CACHE_TTL_MS=600000
SESSION_PATH=./session
